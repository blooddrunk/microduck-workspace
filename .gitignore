# 上游镜像、训练依赖与下载产物：由本地管理，不入此仓库
/microduck/
/microduck_rl/
/policies/official/
/.upstreams/

# Python 与实验缓存
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.onnx
*.pt

# 本机采集的大型/敏感数据；放在记录中引用其路径与校验值
records/*.csv
records/*.json
records/*.log
records/*.mp4
records/*.zip
records/*.png
records/*.jpg

# apps/ 应用本地密钥与虚拟环境：正本入库，密钥永不入库
/apps/*/.env
/apps/*/.env.*
/apps/*/.venv/

# Private evidence bundles and operator inventory (never auto-publish)
/.evidence/
/local/

# Never stage raw/private field captures by accident (public GitHub repository)
/records/field/**/raw/
/records/field/**/private/
/records/field/**/originals/
/records/field/**/*.log
/records/field/**/*.pcap
/records/field/**/*.zip
/records/field/**/*.png
/records/field/**/*.jpg
/records/field/**/*.jpeg
/records/field/**/*.mp4
