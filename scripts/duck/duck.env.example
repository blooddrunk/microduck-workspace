# scripts/duck/duck.env.example —— 复制为 local/duck.env 后按实际情况填写
#   cp scripts/duck/duck.env.example local/duck.env
# local/ 已被 .gitignore 忽略：密码、内网拓扑等私有信息只放那里，绝不提交。
# 所有 scripts/duck/*.sh 都会自动读取 local/duck.env；也可用环境变量临时覆盖。

# ---- 鸭子本体 -------------------------------------------------------------
# 鸭子的 IP 或主机名。IP 会随 WiFi 变化，连不上时先跑 scripts/duck/find-duck.sh。
DUCK_HOST=192.168.8.161
DUCK_USER=radxa
DUCK_PORT=22

# ---- 可选：经路由器跳板（当鸭子在另一个网段/异地时）-----------------------
# 例：GL 路由器在 Tailscale 里可达（100.64.0.8），鸭子在其 192.168.8.x 网段：
# DUCK_JUMP=root@100.64.0.8
# 注意：跳板机必须先配好免密（ssh-copy-id），否则脚本会卡在密码输入。

# ---- 可选：额外 ssh 选项（写成单个字符串）---------------------------------
# DUCK_SSH_OPTS='-o ConnectTimeout=5'
# DUCK_CONNECT_TIMEOUT=8

# ---- 同步白名单（pull-duck.sh / push-duck.sh 使用）------------------------
# 拉取鸭子家目录下这些子目录（相对 $HOME）；逗号分隔。不要写 venv/数据集路径。
DUCK_PULL_DIRS=.config/microduck,microduck,duck,projects
# 推送到鸭子的本地目录白名单（相对仓库根）；逗号分隔。push-duck.sh 只允许这些。
DUCK_PUSH_DIRS=scripts/duck/remote
